# Gitignore for Mirror

# Flutter / Dart
client/.dart_tool/
client/.flutter-plugins
client/.flutter-plugins-dependencies
client/.packages
client/build/
client/windows/flutter/ephemeral/

# Java / Gradle
server/.gradle/
server/build/
server/out/
*.class
*.jar
!server/libs/*.jar

# IDE & OS
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DS_Store
Thumbs.db

# Windows C++ Build
*.obj
*.exe
*.dll
*.pdb
*.ilk

